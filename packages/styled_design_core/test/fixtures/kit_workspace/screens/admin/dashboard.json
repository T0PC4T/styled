{
  "format": 1,
  "id": "admin.dashboard",
  "kind": "page",
  "title": "Administration",
  "route": "/admin",
  "frame": "frames.admin",
  "fixtures": {
    "default": {
      "counts": {
        "automations": 3,
        "paused": 1
      }
    }
  },
  "root": {
    "id": "page",
    "type": "StyledListView",
    "props": {
      "style": "StyleContentList.normal"
    },
    "children": [
      {
        "id": "title",
        "type": "OnboardingPageTitle",
        "props": {
          "title": "Administration",
          "subtitle": "Everything that runs your onboarding"
        }
      },
      {
        "id": "tiles",
        "type": "OnboardingGrid",
        "props": {
          "minItemWidth": "gridMinItemWidth",
          "spacing": "padding"
        },
        "children": [
          {
            "id": "automationsTile",
            "type": "OnboardingKpiCard",
            "props": {
              "label": "Automations",
              "value": {
                "$text": "{{data.counts.automations}}"
              },
              "icon": "bolt"
            },
            "on": {
              "tap": [
                {
                  "do": "navigate",
                  "to": "admin.automations",
                  "mode": "replaceAll"
                }
              ]
            }
          },
          {
            "id": "pausedNotice",
            "type": "OnboardingCard",
            "when": {
              "$gt": [
                {
                  "$bind": "data.counts.paused"
                },
                0
              ]
            },
            "props": {
              "style": "StyleCard.highlight"
            },
            "children": [
              {
                "id": "pausedTitle",
                "type": "StyledText",
                "props": {
                  "text": {
                    "$text": "{{data.counts.paused}} paused"
                  },
                  "style": "StyleText.h4"
                }
              },
              {
                "id": "pausedBody",
                "type": "StyledText",
                "props": {
                  "text": "Paused automations send nothing until you enable them.",
                  "style": "StyleText.bodySubtle"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
