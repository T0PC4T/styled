        },
        "on": {
          "tap": [
            {
              "do": "openModal",
              "screen": "app.home"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "OnboardingButton",
        "props": {
          "label": "Go"
        },
        "on": {
          "tap": [
            {
              "do": "navigate",
              "to": "app.create"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "OnboardingButton",
        "props": {
          "label": "Go"
        },
        "on": {
          "tap": [
            {
              "do": "closeModal"
            }
          ]
        }
      }
    ]
