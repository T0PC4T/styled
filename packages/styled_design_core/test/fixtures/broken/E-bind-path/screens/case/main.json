  "fixtures": {
    "default": {
      "items": [
        {
          "id": "a",
          "name": "A"
        }
      ],
      "metrics": [
        {
          "key": "a",
          "count": 1
        }
      ]
    }
  },
  "root": {
    "id": "page",
    "type": "StyledListView",
    "props": {
      "style": "StyleContentList.normal"
    },
    "children": [
      {
        "id": "a",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "data.itms"
          }
        }
      },
      {
        "id": "b",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "state.nme"
          }
        }
      },
      {
        "id": "c",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "params.id"
          }
        }
      },
      {
        "id": "d",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "query.tb"
          }
        }
      },
      {
        "id": "strip",
        "type": "OnboardingMetricStrip",
        "slots": {
          "metrics": [
            {
              "id": "metric",
              "type": "OnboardingMetric",
              "repeat": {
                "over": {
