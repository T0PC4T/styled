              },
              "props": {
                "key": {
                  "$bind": "m.kee"
                },
                "count": {
                  "$bind": "m.count"
                }
              }
            }
          ]
        }
      },
      {
        "id": "list",
        "type": "CrudView",
        "props": {
          "items": {
            "$bind": "data.items"
          }
        },
        "slots": {
          "empty": [
            {
              "id": "e",
              "type": "StyledText",
              "props": {
                "text": "x"
              }
            }
          ],
          "table": [
            {
              "id": "tbl",
              "type": "OnboardingDataTable",
              "props": {
                "rows": {
                  "$bind": "items"
                }
              },
              "slots": {
                "columns": [
                  {
                    "id": "col",
                    "type": "OnboardingTableColumn",
                    "props": {
                      "label": "C"
                    },
                    "slots": {
                      "cell": [
                        {
                          "id": "cellText",
                          "type": "StyledText",
                          "props": {
                            "text": {
                              "$bind": "row.nme"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "id": "set",
        "type": "OnboardingButton",
        "props": {
          "label": "Go"
        },
        "on": {
          "tap": [
            {
              "do": "setState",
              "set": {
                "nam": "x"
              }
            }
          ]
        }
      },
      {
        "id": "f",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "data.items.0.nme"
          }
        }
      },
      {
        "id": "g",
        "type": "StyledText",
        "props": {
          "text": {
            "$bind": "data.items.name"
          }
        }
      }
